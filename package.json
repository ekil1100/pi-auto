{
  "name": "pi-auto",
  "version": "0.1.0",
  "description": "Automatically select thinking effort for each task without changing the current Pi model",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "effort-router"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "uv run --project benchmarks --locked python -m benchmarks.aider",
    "benchmark:test": "uv run --project benchmarks --locked python -m unittest discover -s benchmarks/tests -v"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
